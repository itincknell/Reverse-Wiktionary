# Copy to deploy/web/.env on the VM. Do not commit deploy/web/.env.
REVERSE_WIKTIONARY_DATA_ROOT=/opt/reverse-wiktionary/data
WEB_IMAGE=reverse-wiktionary-web:<git_sha>
WEB_SKIP_BUILD=true
ASSET_VERSION=<git_sha>
COLLECTION_NAME=reverse_wiktionary_v5
MODEL_NAME=sentence-transformers/all-mpnet-base-v2
TORCH_VERSION=2.12.0+cpu
MODEL_DEVICE=auto
QDRANT_HNSW_EF=512
QDRANT_ACORN_MAX_SELECTIVITY=1.0
SEARCH_EXACT_FILTERED=false
DEFAULT_LIMIT=25
MAX_LIMIT=100
SESSION_TTL_SECONDS=86400
AUDIO_FETCH_CONNECT_TIMEOUT_SECONDS=2
AUDIO_FETCH_READ_TIMEOUT_SECONDS=8
AUDIO_FETCH_MAX_BYTES=5242880
AUDIO_FETCH_USER_AGENT="Reverse-Wiktionary/1.1 (https://reverse-wiktionary.com)"

# Empty for SSH-only preview; set to cloudflare with CLOUDFLARE_TUNNEL_TOKEN.
COMPOSE_PROFILES=
CLOUDFLARE_TUNNEL_TOKEN=
