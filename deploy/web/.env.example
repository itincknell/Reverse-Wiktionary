# Copy to deploy/web/.env on the VM. Do not commit deploy/web/.env.
REVERSE_WIKTIONARY_DATA_ROOT=/opt/reverse-wiktionary/data
COLLECTION_NAME=reverse_wiktionary_v2
MODEL_NAME=sentence-transformers/distiluse-base-multilingual-cased-v2
MODEL_DEVICE=auto
QDRANT_HNSW_EF=512
QDRANT_ACORN_MAX_SELECTIVITY=1.0
SEARCH_EXACT_FILTERED=false
DEFAULT_LIMIT=25
MAX_LIMIT=100
SESSION_TTL_SECONDS=86400

# Leave COMPOSE_PROFILES empty for SSH-only preview.
# Set it to cloudflare when CLOUDFLARE_TUNNEL_TOKEN is configured.
COMPOSE_PROFILES=
CLOUDFLARE_TUNNEL_TOKEN=
